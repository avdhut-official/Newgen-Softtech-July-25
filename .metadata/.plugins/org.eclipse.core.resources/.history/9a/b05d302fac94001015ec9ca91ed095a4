package com.selenium.basics.selenium_maven_project;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.firefox.FirefoxDriver;

public class BasicsAutomation {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		//creating driver object to open chrome browser
		WebDriver driver_chrome=new ChromeDriver(); //default constructor
		
		//maximize the browser
		driver_chrome.manage().window().maximize();
		
		//will take you to requested webpage
		driver_chrome.get("https://www.google.com/");
		
		//get the title of webpage
		String title= driver_chrome.getTitle();
		System.out.println(title);
		
		WebDriver driver_mozilla=new FirefoxDriver(); //default constructor
		driver_mozilla.get("https://www.flipkart.com");
		
	}

}










